[Unit]
Description=Beehive interior timelapse camera
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/beehive-automation
ExecStart=/usr/bin/python3 -m pi.services.camera_inside --config /etc/beehive/config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
